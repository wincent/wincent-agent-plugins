#!/bin/sh

set -eu

cd "$(dirname "$0")/.."

status=0
python3 -B -m unittest discover -s pi/extensions/tests -p '*_test.py' || status=1
node --experimental-transform-types --test pi/extensions/tests/*.test.mjs || status=1
node pi/extensions/subagent/tests/run.mjs || status=1
node --test pi/skills/atlassian-confluence/tests/*.test.mjs || status=1
exit "$status"
